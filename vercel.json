{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/s/:id.m3u",
      "destination": "/api/stream?id=:id&fmt=m3u"
    },
    {
      "source": "/s/:id.pls",
      "destination": "/api/stream?id=:id&fmt=pls"
    },
    {
      "source": "/d/:id.mp3",
      "destination": "/api/dl?id=:id"
    }
  ]
}
